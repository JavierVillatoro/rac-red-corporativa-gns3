# HQ-DIST1 - Fase 3.3: VRRP (pasarela virtual .1) en cada VLAN, solo IPv4. Aplicar despues de 05.
# Maestro (prioridad 200): DIST1 en VLAN 10,20,30,70; DIST2 en 40,50,60,80,99. El otro, respaldo (100).
/interface vrrp add name=vrrp10-INV interface=vlan10-INV vrid=10 priority=200 comment="VLAN 10: maestro"
/ip address add address=10.1.10.1/32 interface=vrrp10-INV comment="pasarela virtual VLAN 10"
/interface vrrp add name=vrrp20-COM interface=vlan20-COM vrid=20 priority=200 comment="VLAN 20: maestro"
/ip address add address=10.1.20.1/32 interface=vrrp20-COM comment="pasarela virtual VLAN 20"
/interface vrrp add name=vrrp30-VEN interface=vlan30-VEN vrid=30 priority=200 comment="VLAN 30: maestro"
/ip address add address=10.1.30.1/32 interface=vrrp30-VEN comment="pasarela virtual VLAN 30"
/interface vrrp add name=vrrp40-CUR interface=vlan40-CUR vrid=40 priority=100 comment="VLAN 40: respaldo"
/ip address add address=10.1.40.1/32 interface=vrrp40-CUR comment="pasarela virtual VLAN 40"
/interface vrrp add name=vrrp50-SOP interface=vlan50-SOP vrid=50 priority=100 comment="VLAN 50: respaldo"
/ip address add address=10.1.50.1/32 interface=vrrp50-SOP comment="pasarela virtual VLAN 50"
/interface vrrp add name=vrrp60-GUEST interface=vlan60-GUEST vrid=60 priority=100 comment="VLAN 60: respaldo"
/ip address add address=10.1.60.1/32 interface=vrrp60-GUEST comment="pasarela virtual VLAN 60"
/interface vrrp add name=vrrp70-STO interface=vlan70-STO vrid=70 priority=200 comment="VLAN 70: maestro"
/ip address add address=10.1.70.1/32 interface=vrrp70-STO comment="pasarela virtual VLAN 70"
/interface vrrp add name=vrrp80-CPU interface=vlan80-CPU vrid=80 priority=100 comment="VLAN 80: respaldo"
/ip address add address=10.1.80.1/32 interface=vrrp80-CPU comment="pasarela virtual VLAN 80"
/interface vrrp add name=vrrp99-MGMT interface=vlan99-MGMT vrid=99 priority=100 comment="VLAN 99: respaldo"
/ip address add address=10.1.99.1/32 interface=vrrp99-MGMT comment="pasarela virtual VLAN 99"
