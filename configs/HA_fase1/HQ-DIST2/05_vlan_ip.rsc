# HQ-DIST2 - Fase 3.2: direcciones de las VLAN (.3 / ::3) y OSPF pasivo. Aplicar despues de 04.
# advertise=no: los RA (SLAAC) se activan en el paso 3.4. La .1 virtual (VRRP) llega en el 3.3.
/ip address add address=10.1.10.3/24 interface=vlan10-INV comment="VLAN 10 INV"
/ipv6 address add address=2001:db8:1:10::3/64 interface=vlan10-INV advertise=no comment="VLAN 10 INV GUA"
/ipv6 address add address=fdce:f6ae:a8d8:1010::3/64 interface=vlan10-INV advertise=no comment="VLAN 10 INV ULA"
/ip address add address=10.1.20.3/24 interface=vlan20-COM comment="VLAN 20 COM"
/ipv6 address add address=2001:db8:1:20::3/64 interface=vlan20-COM advertise=no comment="VLAN 20 COM GUA"
/ipv6 address add address=fdce:f6ae:a8d8:1020::3/64 interface=vlan20-COM advertise=no comment="VLAN 20 COM ULA"
/ip address add address=10.1.30.3/24 interface=vlan30-VEN comment="VLAN 30 VEN"
/ipv6 address add address=2001:db8:1:30::3/64 interface=vlan30-VEN advertise=no comment="VLAN 30 VEN GUA"
/ipv6 address add address=fdce:f6ae:a8d8:1030::3/64 interface=vlan30-VEN advertise=no comment="VLAN 30 VEN ULA"
/ip address add address=10.1.40.3/24 interface=vlan40-CUR comment="VLAN 40 CUR"
/ipv6 address add address=2001:db8:1:40::3/64 interface=vlan40-CUR advertise=no comment="VLAN 40 CUR GUA"
/ipv6 address add address=fdce:f6ae:a8d8:1040::3/64 interface=vlan40-CUR advertise=no comment="VLAN 40 CUR ULA"
/ip address add address=10.1.50.3/24 interface=vlan50-SOP comment="VLAN 50 SOP"
/ipv6 address add address=2001:db8:1:50::3/64 interface=vlan50-SOP advertise=no comment="VLAN 50 SOP GUA"
/ipv6 address add address=fdce:f6ae:a8d8:1050::3/64 interface=vlan50-SOP advertise=no comment="VLAN 50 SOP ULA"
/ip address add address=10.1.60.3/24 interface=vlan60-GUEST comment="VLAN 60 GUEST"
/ipv6 address add address=2001:db8:1:60::3/64 interface=vlan60-GUEST advertise=no comment="VLAN 60 GUEST GUA"
/ip address add address=10.1.70.3/24 interface=vlan70-STO comment="VLAN 70 STO"
/ipv6 address add address=fdce:f6ae:a8d8:1070::3/64 interface=vlan70-STO advertise=no comment="VLAN 70 STO ULA"
/ip address add address=10.1.80.3/24 interface=vlan80-CPU comment="VLAN 80 CPU"
/ipv6 address add address=fdce:f6ae:a8d8:1080::3/64 interface=vlan80-CPU advertise=no comment="VLAN 80 CPU ULA"
/ip address add address=10.1.99.3/24 interface=vlan99-MGMT comment="VLAN 99 MGMT"
/ipv6 address add address=fdce:f6ae:a8d8:1099::3/64 interface=vlan99-MGMT advertise=no comment="VLAN 99 MGMT ULA"
/routing ospf interface-template add area=backbone-v2 networks=10.1.10.0/24,10.1.20.0/24,10.1.30.0/24,10.1.40.0/24,10.1.50.0/24 passive comment="VLAN usuarios 10-50"
/routing ospf interface-template add area=backbone-v2 networks=10.1.60.0/24 passive comment="VLAN invitados 60"
/routing ospf interface-template add area=backbone-v2 networks=10.1.70.0/24,10.1.80.0/24,10.1.99.0/24 passive comment="VLAN internas 70 80 99"
/routing ospf interface-template add area=backbone-v3 networks=2001:db8:1:10::/64,2001:db8:1:20::/64,2001:db8:1:30::/64 passive comment="VLAN usuarios 10-30 GUA"
/routing ospf interface-template add area=backbone-v3 networks=2001:db8:1:40::/64,2001:db8:1:50::/64 passive comment="VLAN usuarios 40-50 GUA"
/routing ospf interface-template add area=backbone-v3 networks=fdce:f6ae:a8d8:1010::/64,fdce:f6ae:a8d8:1020::/64,fdce:f6ae:a8d8:1030::/64 passive comment="VLAN usuarios 10-30 ULA"
/routing ospf interface-template add area=backbone-v3 networks=fdce:f6ae:a8d8:1040::/64,fdce:f6ae:a8d8:1050::/64 passive comment="VLAN usuarios 40-50 ULA"
/routing ospf interface-template add area=backbone-v3 networks=2001:db8:1:60::/64 passive comment="VLAN invitados 60 GUA"
/routing ospf interface-template add area=backbone-v3 networks=fdce:f6ae:a8d8:1070::/64,fdce:f6ae:a8d8:1080::/64,fdce:f6ae:a8d8:1099::/64 passive comment="internas ULA"
