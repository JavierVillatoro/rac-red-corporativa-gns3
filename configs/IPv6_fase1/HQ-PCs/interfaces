# PCs de HQ (Docker Alpine) - clic derecho -> Edit config (/etc/network/interfaces, persistente).
# Mismo bloque en HQ-PC-INV, HQ-PC-COM, HQ-PC-VEN, HQ-PC-CUR, HQ-PC-SOP y HQ-PC-GUEST:
# la VLAN la decide el puerto del switch, la direccion la forma el PC por SLAAC (RA de los DIST).

auto eth0
iface eth0 inet6 manual
    pre-up echo 0 > /proc/sys/net/ipv6/conf/eth0/disable_ipv6
    pre-up echo 1 > /proc/sys/net/ipv6/conf/eth0/accept_ra
    pre-up echo 1 > /proc/sys/net/ipv6/conf/eth0/autoconf
